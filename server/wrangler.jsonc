{
  // SPLURT online relay: one Durable Object per room code (WebSocket fan-out + membership + host election).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "inkwave-net",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "PRIZES", "class_name": "Prizes" }, { "name": "MATCHMAKER", "class_name": "Matchmaker" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Prizes"] }, { "tag": "v3", "new_sqlite_classes": ["Matchmaker"] }],
  // Optional Solana prize pool (docs/PRIZE_POOL.md). Off unless SOLANA_RPC_URL and TREASURY_PUBLIC_KEY are set.
  // Non-secret settings can go in "vars"; TREASURY_SECRET_KEY only ever via `wrangler secret put` (or .dev.vars locally).
  "vars": { "PAYOUT_MODE": "dry-run" },
  // Deploys keep any other vars you set in the Cloudflare dashboard (RPC URL, treasury public key, prize settings).
  "keep_vars": true,
  // Public relay endpoint for playsplurt.online (Cloudflare creates the DNS record + cert for a custom domain).
  "routes": [{ "pattern": "api.playsplurt.online", "custom_domain": true }],
  "observability": { "enabled": false }
}
