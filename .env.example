# INKWAVE relay — optional Solana prize pool (docs/PRIZE_POOL.md).
# Leave SOLANA_RPC_URL / TREASURY_PUBLIC_KEY empty and the game runs exactly as before: no wallet UI, no prizes.
#
# Local dev: copy to server/.dev.vars (read by `npm run relay` / `wrangler dev`). Production: non-secret values as
# Worker vars, the secret ONLY via `cd server && npx wrangler secret put TREASURY_SECRET_KEY`.
# Never commit a filled-in copy: .env*, .dev.vars are git-ignored.

# JSON-RPC endpoint (a paid provider such as Helius / Triton / QuickNode for production; devnet for testing)
SOLANA_RPC_URL=https://api.devnet.solana.com
# the coin's mint address (pump.fun shows it on the coin page); only needed for MIN_TOKEN_HOLDING
TOKEN_MINT=
# the wallet that receives the creator trading fees and pays the prizes (public address)
TREASURY_PUBLIC_KEY=
# that wallet's secret key: solana-keygen JSON array [..64 numbers..] or a base58 export. Only needed for PAYOUT_MODE=live.
TREASURY_SECRET_KEY=
# dry-run (default): draw and log prizes, send nothing.  live: actually transfer SOL. Anything but "live" = dry-run.
PAYOUT_MODE=dry-run
# each round's prize is drawn uniformly between these percentages of the pool balance...
PRIZE_MIN_PCT=1
PRIZE_MAX_PCT=5
# ...capped at this many SOL...
PRIZE_MAX_SOL=1
# ...and never touching this much (keeps the treasury able to pay fees / stay rent-exempt)
PRIZE_RESERVE_SOL=0.05
# fewest human players (connected browsers) at match start for a round to carry a prize
MIN_HUMAN_PLAYERS=2
# tokens of TOKEN_MINT a winner must hold (0 = no requirement)
MIN_TOKEN_HOLDING=0
# a wallet that won can't win again for this many seconds
PRIZE_COOLDOWN_SEC=3600
