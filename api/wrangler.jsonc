{
  // DRAFTPUMP: site + API in one Worker (https://draftpump.<your-subdomain>.workers.dev)
  "name": "draftpump",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "../site", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "LEAGUE", "class_name": "League" }, { "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["League", "Room"] }],
  // a free address on your existing domain until DRAFTPUMP gets its own (also live at draftpump.<subdomain>.workers.dev)
  "routes": [{ "pattern": "draftpump.playsplurt.online", "custom_domain": true }],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
